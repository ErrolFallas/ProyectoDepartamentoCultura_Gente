# =========================================================
# Garnier PulseWork - Variables de entorno
# =========================================================
# Copiar este archivo a .env y completar valores reales.
# Nunca subir .env a git.

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
BACKEND_BASE_URL=http://localhost:3000

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=pulsework_user
DB_PASSWORD=
DB_NAME=garnier_pulsework
DB_CONNECTION_LIMIT=10

# ---------- JWT ----------
JWT_SECRET=cambiar-por-secreto-de-32-bytes-aleatorios
JWT_EXPIRES_IN=8h

# ---------- Gemini (Google AI Studio) ----------
# Si queda vacío, el cliente devuelve respuestas mock con
# estado PENDIENTE_REVISION para no bloquear el desarrollo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Microsoft 365 (lectura de Forms vía Graph) ----------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_DRIVE_ITEM_ID=

# ---------- n8n -> Backend ----------
# Token compartido para autenticar la ingesta desde n8n.
N8N_INGEST_TOKEN=cambiar-por-token-largo-aleatorio

# ---------- Reglas configurables ----------
# Umbral mínimo de respuestas para mostrar un departamento
# de forma aislada (protección de anonimato).
MIN_RESPUESTAS_DEPARTAMENTO=5

# Umbrales de clasificación de respuesta normalizada (0-100)
UMBRAL_NEGATIVO_MAX=40
UMBRAL_NEUTRO_MAX=60

# Umbrales de semáforo (porcentaje de respuestas negativas)
SEMAFORO_AMARILLO_MIN=40
SEMAFORO_ROJO_MIN=75
