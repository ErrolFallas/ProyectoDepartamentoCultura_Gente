# =========================================================
# Garnier PulseWork — Variables de entorno
# =========================================================
# Copia este archivo como `.env` (NO subir a git).
# Los valores marcados con [⚠ LLENAR] son los que TÚ debes
# completar antes de correr `npm run migrate`. El resto ya
# tiene valores funcionales para desarrollo local.
# =========================================================

# ---------------------------------------------------------
# Backend
# ---------------------------------------------------------
NODE_ENV=development
PORT=3000
BACKEND_BASE_URL=http://localhost:3000


# ---------------------------------------------------------
# MySQL — [⚠ LLENAR DB_PASSWORD]
# ---------------------------------------------------------
# Si instalaste MySQL nativo (Windows) con el usuario `root`,
# deja DB_USER=root y pon tu contraseña en DB_PASSWORD.
# La base `garnier_pulsework` se crea sola al correr migrate.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=                         # ⚠ LLENAR con tu password de MySQL
DB_NAME=garnier_pulsework
DB_CONNECTION_LIMIT=10


# ---------------------------------------------------------
# JWT — listo para dev (cambiar antes de producción)
# ---------------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-cambiar-en-produccion-32+chars
JWT_EXPIRES_IN=8h


# ---------------------------------------------------------
# Gemini — [opcional: LLENAR si querés IA real]
# ---------------------------------------------------------
# Si la dejás vacía, el backend usa un mock heurístico que
# clasifica polaridad y analiza texto abierto. Tu API key de
# otros proyectos funciona aquí (es la misma de Google AI Studio).
GEMINI_API_KEY=                      # opcional, podés pegar la misma key
# Modelo Gemini. Recomendado: gemini-2.5-flash-lite (rápido + más cuota
# gratuita). Alternativas: gemini-2.5-flash (más capaz, menos cuota),
# gemini-2.5-pro (máxima calidad, requiere plan pagado).
GEMINI_MODEL=gemini-2.5-flash-lite


# ---------------------------------------------------------
# Microsoft 365 — opcional (solo si vas a leer Forms real)
# ---------------------------------------------------------
# En desarrollo podés probar ingesta con curl/Postman; no
# necesitás estas credenciales para ver los paneles.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_DRIVE_ITEM_ID=


# ---------------------------------------------------------
# Token compartido n8n ↔ backend — listo para dev
# ---------------------------------------------------------
N8N_INGEST_TOKEN=dev-only-ingest-token-cambiar-en-produccion-32


# ---------------------------------------------------------
# Reglas configurables del negocio (no requieren edición)
# ---------------------------------------------------------
MIN_RESPUESTAS_DEPARTAMENTO=5
UMBRAL_NEGATIVO_MAX=40
UMBRAL_NEUTRO_MAX=60
SEMAFORO_AMARILLO_MIN=40
SEMAFORO_ROJO_MIN=75
